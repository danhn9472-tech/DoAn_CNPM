## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# Roslyn cache directories
*.ide/

# Test results
TestResults/

# SQL Server files
*.mdf
*.ldf
*.ndf

# Packages
*.nupkg
**/packages/*
!**/packages/build/

# Entity Framework
*.db
*.db-shm
*.db-wal

# Environment secrets
# Thường thì appsettings.json được giữ lại, nhưng appsettings.Development.json 
# có thể chứa connection string cá nhân nên có thể cân nhắc ignore.
appsettings.Development.json

# OS generated files
.DS_Store
Thumbs.db

# User Secrets
secrets.json

# Visual Studio Code
.vscode/

# Logs
*.log
